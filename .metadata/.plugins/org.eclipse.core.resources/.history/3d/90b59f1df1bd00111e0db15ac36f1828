//PWM
#include <stdint.h>
#include <stdio.h>


//--------------------------------Registers-------------------------------

//---RCC (base address 0x40023800)
#define RCC_AHB1ENR ((volatile uint32_t*)0x40023830)//GPIOA bit 0 -> 1
#define RCC_APB1ENR ((volatile uint32_t*)0x40023840)//TIM5 bit 3 -> 1

//---TIM5 (base address 0x40000C00)
#define TIM5_PSC ((volatile uint32_t*)0x40000C28) //0x28 offset PSC. Pg 383
#define TIM5_ARR ((volatile uint32_t*)0x40000C2C) //0x2C offset ARR. Pg 383
#define TIM5_CR1 ((volatile uint32_t*) 0x40000C00) //0x00 offset CR1. Pg 369

//----TIM5 for PWM (base address 0x40000C00). Pg 378.
//Bit 6:4 -> 110 active PWM mode 1.     Bit 3 -> 1 OC1PE. Prevents glitching
#define TIM5_CCMR1 ((volatile uint32_t*) 0x40000C18) //0x18 offset. Pg 377
//Bit 0 -> 1. Enable output on the corresponding output pin. Bit 1 -> 0 for polarity high -> active
#define TIM5_CCER ((volatile uint32_t*)0x40000C20) //0x20 offset. Pg 381.
#define TIM5_CCR1 ((volatile uint32_t*)0x40000C34) //0x34 offset. Pg 384. Count value controls the pulse width

//---GPIOA for PWM. Directing GPIO PA0 to the timer hardware (base address 0x40020000)
#define GPIOA_MODER0 ((volatile uint32_t*)0x40020000) //Set alternate function mode with write 10 in bit 1:0
#define GPIOA_AFRL0 ((volatile uint32_t*)0x40020020) //Offset 0x20.To set GPIO PA0 as TIM5_CH1,  Must write 0010 in bits 3:0

uint32_t duty_cycle = 100;
//REMEMBER *macro |= (1 << b_p); Turn on.   *macro &= ~(1 << b_p); Turn off
void pwm_led(void){
	//1. Enable clock for GPIOA and TIM5
	*RCC_AHB1ENR |= (1 << 0);
	*RCC_APB1ENR |= (1 << 3);

	//2. Configure PA0 for alternate function (TIM5_CH1).
	*GPIOA_MODER0 &= ~(3 << 0); //Clear bits 1:0
	*GPIOA_MODER0 |= (2 << 0); //Write 10 in bits 1:0
	*GPIOA_AFRL0 &= ~(15 << 0); //Clear bits 3:0
	*GPIOA_AFRL0 |= (2 << 0); //Write 0010 bits 3:0

	//3. Configure TIM5 Time base (1 kHz frequency)
	*TIM5_PSC = 15; // with PSC = 15. Make 1 tick each 1us. Fcnt = 1 MHz
	*TIM5_ARR = 999; //fcycle = 1 kHz with ARR = 999. T = 1ms.

	//4. Configure channel 1 for PWM mode 1
	*TIM5_CCMR1 &= ~(7 << 4);
	*TIM5_CCMR1 |= (6 << 4) | (1 << 3); // PWM mode 1 + Preload enabled.
	*TIM5_CCER |= (1 << 0); //Enable channel 1 output
	*TIM5_CCR1 = 250;

	//5. Start the timer.
	*TIM5_CR1 |= (1 << 0);
}

int main(void){
	pwm_led(); //Initialize PWM

	while(1){
		// Gradually sweep duty cycle to fade LED intensity
				duty_cycle += 10;
				if (duty_cycle > 999) {
					duty_cycle = 0;
				}
				*TIM5_CCR1 = duty_cycle;

				// Software delay loop
				for (volatile int i = 0; i < 200000; i++);
	}
	return 0;
}
