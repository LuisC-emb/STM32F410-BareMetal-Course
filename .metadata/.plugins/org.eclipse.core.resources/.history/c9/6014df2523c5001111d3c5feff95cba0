//6_2EXTI
#include "gpio.h"

int main(void)
{
	//Enable RCC->AHB1ENR for GPIOA, set PA0 as MODER 00 = input mode
	gpio_init_input(GPIOA, 0, GPIO_PUPDR_PULLDOWN);

	//1.Enable Peripheral clock on SYSCFG
	RCC->APB2ENR &= ~(0xEU << 1); //Cleaning
	RCC->APB2ENR |= (0xEU << 1); //Set bit

	//2. Connect PA0 to EXTI0 via SYSCFG
	SYSCFG->EXTICR1 &= ~(0xFU << 0);

	//3. Configure EXTI line 0 triggers
	EXTI->IMR &= ~(0x1U << 1); //Set 0 to mask the line
	EXTI->RTSR |= (0x1U << 0); //Set 1 to rising trigger enabled. This trigger when the button transitions from 0V -> 3.3V



	while (1){

	}
	return 0;
}
