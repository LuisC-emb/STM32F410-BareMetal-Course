//1.3''Code to turn change the status of LEDs with buttons

//Librarys
#include <stdint.h>

//Macros section
#define RCC_AHB1ENR ((volatile uint32_t*)0x40023830)  //Clock for peripherals in bus AHB1 (like GPIOA)
#define GPIOA_MODER ((volatile uint32_t*)0x40020000) //MODER = Mode register
#define GPIOA_PUPDR ((volatile uint32_t*)0x4002000C) //PUPDR = Pull up/ pull down register
#define GPIOA_IDR ((volatile uint32_t*)0x40020010) //IDR = Input data register
#define GPIOA_BSRR ((volatile uint32_t*)0x40020018) //BSRR = Bit set/reset register

int main(){
	//1. Enable clock for GPIOA
	*RCC_AHB1ENR |= (1 << 0);

	//2. Configure PA0 as input mode and PA4 as output mode
	*GPIOA_MODER &= ~(3 << 0); //Bits 1:0 set PA0 as 00 (MODER0)
	*GPIOA_MODER &= ~(3 << 8); //Clear bits 5:4 (MODER4)
	*GPIOA_MODER |= (1 << 8);  //Bits 5:4 set PA4 as 01 (MODER4)

	//3. Configure PA0 as pull down register, the base state of PA0 will be LOW
	*GPIOA_PUPDR &= ~(3 << 0);
	*GPIOA_PUPDR |= (2 << 0); //Bits 1:0 set as 10 (PUPDR0).

	//Infinite loop
	while (1){

		//Check the button to PA0
		if (*GPIOA_IDR & (1 << 0)){
		///////if the button is press, turn on led
			*GPIOA_BSRR = (1 << 4);
		}

		//////if not is press, turn off led
		else {
			*GPIOA_BSRR = (1 << 20);
		}


	}
	return 0;
}
